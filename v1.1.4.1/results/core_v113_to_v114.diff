+def record_hash_for(body: Mapping[str, Any], history_key: Optional[bytes] = None) -> str:
+    """Hash of a record body (every CommitRecord field except ``record_hash``).
+
+    Without a key this is ``sha256(canonical_json(body))``, byte-identical to v1.1.3. That form is
+    tamper-EVIDENT only against accidental corruption: anyone who can write the record list can
+    recompute a valid chain. With a ``history_key`` it is ``HMAC-SHA256(key, canonical_json(body))``,
+    so a forged or appended record cannot be made to verify without the key. Output is 64 lowercase
+    hex characters either way, so the ``record_hash`` field format is unchanged.
+    """
+    raw = canonical_json(body)
+    if history_key is None:
+        return hashlib.sha256(raw).hexdigest()
+    return hmac.new(history_key, raw, hashlib.sha256).hexdigest()
+
+
+def verify_record_chain(records: Iterable[Any], *, history_key: Optional[bytes] = None) -> bool:
+    """Verify sequence numbering, back-links and (keyed) record hashes. Never raises; malformed -> False."""
+    previous = "0" * 64
+    try:
+        for index, record in enumerate(records, start=1):
+            if type(record) is not CommitRecord:
+                return False
+            if type(record.sequence) is not int or record.sequence != index or record.previous_record_hash != previous:
+                return False
+            body = asdict(record)
+            claimed = body.pop("record_hash")
+            if not is_sha256(claimed) or not hmac.compare_digest(record_hash_for(body, history_key), claimed):
+                return False
+            previous = claimed
+    except Exception:
+        return False
+    return True
+
