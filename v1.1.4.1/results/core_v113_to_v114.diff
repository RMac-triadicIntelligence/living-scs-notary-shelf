+def _malformed(message: str) -> Refusal:
+    return Refusal(f"malformed input: {message}")
+
+
+def _check_text(text: str, where: str) -> None:
+    try:
+        text.encode("utf-8")
+    except UnicodeEncodeError:
+        raise _malformed(f"{where} is not encodable as UTF-8 (lone surrogate?)") from None
+
+
+def _check_json_value(value: Any, where: str) -> None:
+    """Iterative (no Python recursion) walk of a JSON-like value.
+
+    Refuses: nesting deeper than MAX_NESTING_DEPTH (this also terminates on reference cycles),
+    non-str mapping keys, non-finite floats, ints beyond MAX_SAFE_INTEGER, strings that cannot be
+    encoded as UTF-8, and any non-JSON type.
+    """
+    stack = [(value, 0)]
+    while stack:
+        item, depth = stack.pop()
+        if isinstance(item, str):
+            _check_text(item, where)
+        elif item is None or isinstance(item, bool):
+            continue
+        elif isinstance(item, int):
+            if abs(item) > MAX_SAFE_INTEGER:
+                raise _malformed(f"integer outside +/-2**53 in {where}")
+        elif isinstance(item, float):
+            if not math.isfinite(item):
+                raise _malformed(f"non-finite number in {where}")
+        elif isinstance(item, (dict, list, tuple)):
+            if depth >= MAX_NESTING_DEPTH:
+                raise _malformed(f"nesting deeper than {MAX_NESTING_DEPTH} in {where}")
+            if isinstance(item, dict):
+                for key, inner in item.items():
+                    if type(key) is not str:
+                        raise _malformed(f"non-string object key in {where}")
+                    _check_text(key, where)
+                    stack.append((inner, depth + 1))
+            else:
+                for inner in item:
+                    stack.append((inner, depth + 1))
+        else:
+            raise _malformed(f"unsupported value type {type(item).__name__} in {where}")
+
+
