+def reconcile_persisted_log(
+    persisted_records: Iterable[Any],
+    *,
+    history_key: Optional[bytes] = None,
+    engine_records: Optional[Iterable[Any]] = None,
+) -> tuple[CommitRecord, ...]:
+    """Return the canonical prefix of a record log written by a ``persist_hook``.
+
+    A hook can be called for a commit that is then rolled back (see ``CommitEngine.__init__``), so an
+    append-only log may hold sequence N twice. This helper applies the upsert rule after the fact:
+
+    1. dedupe by ``sequence``, last write wins (the retried commit replaces the rolled-back attempt);
+    2. keep the contiguous run of sequences 1, 2, 3, ... (anything after a gap is dropped);
+    3. keep the longest prefix that passes ``verify_record_chain`` with the engine's ``history_key``;
+    4. if ``engine_records`` (a live engine's ``records``) is given, it is authoritative: cut at the
+       first record that differs from it, so a record whose commit was rolled back and never retried
+       is dropped too. ``engine_records`` must itself verify, otherwise Refusal is raised.
+
+    The caller should then rewrite the persisted log to exactly the returned records (and append
+    ``engine_records[len(result):]`` if the live engine has more). The result always verifies with
+    ``verify_record_chain(result, history_key=history_key)``; an empty tuple means nothing is usable.
+
+    Entries may be ``CommitRecord`` instances or mappings with exactly the CommitRecord field names
+    (for example parsed JSON). A malformed entry raises Refusal: recovery should not guess. Records
+    are only re-hashed to verify them, never re-signed or rewritten; fresh instances are returned.
+
+    Limitation: without ``engine_records`` (for example at a cold start) a final record whose hook
+    wrote durably and then raised, with no retry afterwards, is correctly chained and cannot be told
+    apart from a real commit using the log alone.
+    """
+    names = tuple(f.name for f in fields(CommitRecord))
+    latest: dict[int, CommitRecord] = {}
+    for index, entry in enumerate(persisted_records):
+        try:
+            if type(entry) is CommitRecord:
+                record = replace(entry)
+            elif isinstance(entry, Mapping) and set(entry.keys()) == set(names):
+                record = CommitRecord(**{name: entry[name] for name in names})
+            else:
+                raise TypeError(type(entry).__name__)
+        except Exception as exc:
+            raise Refusal(f"persisted log entry {index} is not a commit record") from exc
+        if type(record.sequence) is not int or record.sequence < 1:
+            raise Refusal(f"persisted log entry {index} has an invalid sequence")
+        latest[record.sequence] = record                       # last write wins
+    run: list[CommitRecord] = []
+    while len(run) + 1 in latest:
+        run.append(latest[len(run) + 1])
+    # Every prefix of a verifying chain verifies, so binary-search the longest verifying prefix.
+    low, high = 0, len(run)
+    while low < high:
+        middle = (low + high + 1) // 2
+        if verify_record_chain(run[:middle], history_key=history_key):
+            low = middle
+        else:
+            high = middle - 1
+    result = run[:low]
+    if engine_records is not None:
+        authoritative = list(engine_records)
+        if not verify_record_chain(authoritative, history_key=history_key):
+            raise Refusal("engine records do not verify; cannot reconcile against them")
+        common = 0
+        while common < len(result) and common < len(authoritative) and result[common] == authoritative[common]:
+            common += 1
+        result = result[:common]
+    return tuple(result)
+
